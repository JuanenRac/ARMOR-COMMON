{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armor.local/schemas/solar-battery-command-0.1.0.json",
  "title": "A.R.M.O.R. order to write to a Pylontech battery",
  "description": "An order to one battery port of one ARMOR-SOLAR node, published by the server to armor/solar/{node_id}/maintenance/command (never retained, at most once). Only typed operations exist (see battery_ops.json). Writing is two steps: `arm` (the node reads the battery, checks every precondition and answers with a one-time `token` and the exact operation) then `execute` carrying that token within two minutes and the same operation and serial. `cancel` stops an operation that may still be stopped. `stage` carries one piece of a firmware image to the node before an arm of firmware_update. A node refuses everything unless its own setting allows it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "node_id",
    "timestamp_ms",
    "command_id",
    "port",
    "action"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "solar_battery_command"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-z0-9]{8,32}$",
      "description": "Chosen by the server; the node repeats it in its answer."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "The node's serial port (1 to 10) where the battery's console is connected."
    },
    "action": {
      "type": "string",
      "enum": [
        "arm",
        "execute",
        "cancel",
        "stage"
      ]
    },
    "op": {
      "type": "string",
      "enum": [
        "set_clock",
        "clear_stats",
        "clear_log",
        "clear_data",
        "restart",
        "shutdown",
        "soc_capacity",
        "mosfail_test",
        "soc_reset",
        "pcb_setup",
        "limits_set",
        "limits_default",
        "protections_set",
        "protections_default",
        "output_set",
        "fault_clear",
        "write_barcode",
        "eeprom_erase",
        "firmware_update",
        "expert_command"
      ],
      "description": "On arm and execute: the operation. Its values are checked by validate_solar_battery_command against battery_ops.json."
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "description": "The values of the operation (arm and execute carry the same). Which names an operation takes, and their ranges, are in battery_ops.json and are checked by validate_solar_battery_command.",
      "properties": {
        "which": {
          "type": "string",
          "enum": [
            "event",
            "history"
          ]
        },
        "group": {
          "type": "string",
          "enum": [
            "module_voltage",
            "cell_voltage",
            "temperature"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "description": "A whole group of limits, in milli-volts or milli-degrees.",
          "properties": {
            "pov": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "povr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "phv": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "phvr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "plv": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "plvr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "puv": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "puvr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "pslp": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "bov": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "bovr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "bhv": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "bhvr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "blv": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "blvr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "buv": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "buvr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "bslp": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "cot": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "cotr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "cht": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "chtr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "clt": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "cltr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "cut": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            },
            "cutr": {
              "type": "integer",
              "minimum": -40000,
              "maximum": 100000
            }
          }
        },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "description": "Protections to enable (en) or disable (dis).",
          "properties": {
            "bov": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "bhv": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "blv": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "buv": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "bslp": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "pov": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "phv": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "plv": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "puv": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "pslp": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "coc": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "coc2": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "doc": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            },
            "doc2": {
              "type": "string",
              "enum": [
                "en",
                "dis"
              ]
            }
          }
        },
        "accept_risk": {
          "type": "boolean"
        },
        "output": {
          "type": "string",
          "enum": [
            "cfet",
            "dfet",
            "buzz",
            "heat"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ]
        },
        "serial": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{10,24}$"
        },
        "restore_barcode": {
          "type": "boolean"
        },
        "image_size": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 524288
        },
        "image_crc32": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "image_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "clear_eeprom": {
          "type": "boolean"
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        }
      }
    },
    "serial": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,24}$",
      "description": "The serial number of the battery as the person typed it to confirm which battery this is (NOSERIAL for a battery that has none yet). The node compares it with the one the battery reports."
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Only on execute: the token the node gave in the answer to the arm."
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "total",
        "size",
        "crc32",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]{8,32}$"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2047
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "size": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 524288
        },
        "crc32": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "data": {
          "type": "string",
          "minLength": 4,
          "maxLength": 344,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "description": "Up to 256 bytes of the image, in base64."
        }
      }
    }
  }
}
