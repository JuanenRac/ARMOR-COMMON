{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armor.local/schemas/solar-inverter-0.1.0.json",
  "title": "A.R.M.O.R. solar inverter reading",
  "description": "The readings of one solar inverter as a gateway node read them from its serial port (Voltronic / MPP Solar family). Published to armor/solar/{node_id}/{device}/state every few seconds and on a change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "node_id",
    "device",
    "timestamp_ms",
    "mode",
    "grid_v",
    "grid_hz",
    "out_v",
    "out_hz",
    "out_va",
    "out_w",
    "load_percent",
    "battery_v",
    "battery_a",
    "battery_percent",
    "pv_v",
    "pv_a",
    "pv_w",
    "heatsink_c",
    "ac_charging",
    "pv_charging",
    "load_on",
    "warnings"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "inverter"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "device": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "type": "string",
      "enum": [
        "power_on",
        "standby",
        "line",
        "battery",
        "fault",
        "power_saving",
        "shutdown",
        "unknown"
      ]
    },
    "grid_v": {
      "type": "number",
      "minimum": 0,
      "maximum": 600,
      "description": "Grid (utility) voltage."
    },
    "grid_hz": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "out_v": {
      "type": "number",
      "minimum": 0,
      "maximum": 600,
      "description": "AC output voltage."
    },
    "out_hz": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "out_va": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000,
      "description": "Apparent output power."
    },
    "out_w": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000,
      "description": "Active output power."
    },
    "load_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 200
    },
    "battery_v": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "battery_a": {
      "type": "number",
      "minimum": -1000,
      "maximum": 1000,
      "description": "Battery current: positive while charging, negative while discharging."
    },
    "battery_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "pv_v": {
      "type": "number",
      "minimum": 0,
      "maximum": 1500
    },
    "pv_a": {
      "type": "number",
      "minimum": 0,
      "maximum": 500
    },
    "pv_w": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000,
      "description": "Power from the panels: the sum of every PV input when the inverter has more than one (then pv2_* say the second)."
    },
    "heatsink_c": {
      "type": "number",
      "minimum": -50,
      "maximum": 200
    },
    "ac_charging": {
      "type": "boolean"
    },
    "pv_charging": {
      "type": "boolean"
    },
    "load_on": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "description": "Names of the active warnings and faults."
    },
    "pv2_v": {
      "type": "number",
      "minimum": 0,
      "maximum": 1500,
      "description": "Voltage of the second PV input, for an inverter that has one (the answer to QPIGS2)."
    },
    "pv2_a": {
      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "description": "Current of the second PV input."
    },
    "pv2_w": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000,
      "description": "Power of the second PV input (already counted in pv_w)."
    },
    "total_out_w": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Active output power of the whole parallel system, when the node reads the units (QPGS)."
    },
    "total_out_va": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Apparent output power of the whole parallel system."
    },
    "total_load_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 200,
      "description": "Load of the whole parallel system."
    },
    "total_charging_a": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "description": "Battery charging current of the whole parallel system."
    },
    "units": {
      "type": "array",
      "maxItems": 10,
      "description": "The inverters of a parallel system as the one on this port reports them (QPGS0 to QPGS9), one entry per unit. Only what a unit tells is listed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "mode"
        ],
        "properties": {
          "unit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9,
            "description": "The unit's number in the parallel system, from 0."
          },
          "serial": {
            "type": "string",
            "maxLength": 24
          },
          "mode": {
            "type": "string",
            "enum": [
              "power_on",
              "standby",
              "line",
              "battery",
              "fault",
              "power_saving",
              "shutdown",
              "unknown"
            ]
          },
          "fault_code": {
            "type": "string",
            "pattern": "^[0-9]{2}$",
            "description": "The two-digit fault code of the unit; 00 is no fault."
          },
          "grid_v": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          },
          "out_v": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          },
          "out_va": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "out_w": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "load_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 200
          },
          "battery_v": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "battery_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "pv_v": {
            "type": "number",
            "minimum": 0,
            "maximum": 1500
          },
          "charging_a": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000,
            "description": "This unit's battery charging current."
          }
        }
      }
    },
    "bus_v": {
      "type": "number",
      "minimum": 0,
      "maximum": 1500,
      "description": "The DC bus voltage inside the inverter; left out when the dialect does not say."
    },
    "serial": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{8,20}$",
      "description": "The inverter's serial number (QID), when it says it."
    },
    "firmware": {
      "type": "string",
      "pattern": "^[0-9A-Za-z._-]{1,24}$",
      "description": "The inverter's firmware version (QVFW), when it says it."
    },
    "pv_energy_total_wh": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000.0,
      "description": "The energy the panels have made since the unit was new, in Wh as the protocol gives it (QET), when the unit says it."
    },
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the unit is rated for and how it is set (QPIRI), when it says it; every member is optional.",
      "properties": {
        "grid_rating_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "out_rating_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "out_rating_hz": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "out_rating_va": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "out_rating_w": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "battery_rating_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "battery_recharge_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "battery_under_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "battery_bulk_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "battery_float_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "max_charge_a": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "max_ac_charge_a": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "battery_type": {
          "type": "string",
          "enum": [
            "agm",
            "flooded",
            "user"
          ]
        },
        "input_range": {
          "type": "string",
          "enum": [
            "appliance",
            "ups"
          ]
        },
        "output_priority": {
          "type": "string",
          "enum": [
            "utility_first",
            "solar_first",
            "sbu"
          ]
        },
        "charger_priority": {
          "type": "string",
          "enum": [
            "utility_first",
            "solar_first",
            "solar_and_utility",
            "solar_only"
          ]
        }
      }
    }
  }
}
