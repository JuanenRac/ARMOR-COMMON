{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armor.local/schemas/node-control-result-0.1.0.json",
  "title": "A.R.M.O.R. answer of a node to an order from the server",
  "description": "What a node answers, published to armor/control/{node_id}/result (never retained). Stage `armed`: the arm was accepted and the answer carries the one-time `token`. Stage `restarting` (the `node_restarting` acknowledgement): sent just BEFORE the node restarts, with why, how long it has been up, its firmware and when it will go. Stage `applied`: pause, resume, standby, identify or maintenance took effect and the answer says the state the node is in now. Stage `diagnostics`: the read-only snapshot. Stage `rejected`: the order was refused and `refusal` says why (nothing was done).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "node_id",
    "timestamp_ms",
    "command_id",
    "action",
    "operation",
    "stage",
    "accepted",
    "refusal"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "node_control_result"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-z0-9]{8,32}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "arm",
        "execute"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "restart",
        "pause",
        "resume",
        "standby",
        "identify",
        "diagnostics",
        "maintenance_on",
        "maintenance_off"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "armed",
        "restarting",
        "applied",
        "diagnostics",
        "rejected"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "refusal": {
      "type": "string",
      "enum": [
        "none",
        "not_armed",
        "invalid_token",
        "token_expired",
        "rate_limited",
        "already_restarting",
        "already_in_state",
        "busy_update",
        "busy_upload",
        "busy_slot_copy",
        "busy_battery",
        "unavailable"
      ]
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]{16,32}$",
      "description": "Only in the answer to an accepted arm."
    },
    "token_ttl_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "description": "Only with the token: how long it is good for."
    },
    "reason": {
      "type": "string",
      "enum": [
        "requested_by_server"
      ],
      "description": "Only in stage restarting."
    },
    "mode": {
      "type": "string",
      "enum": [
        "now",
        "rolling"
      ],
      "description": "Only in stage restarting."
    },
    "restart_in_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600,
      "description": "Only in stage restarting: seconds until the node goes."
    },
    "uptime_s": {
      "type": "integer",
      "minimum": 0,
      "description": "Only in stage restarting."
    },
    "firmware": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Only in stage restarting."
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._@ -]{1,64}$",
      "description": "In stage restarting and stage applied: the person the order was for, as the order said."
    },
    "state": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "standby"
      ],
      "description": "Only in stage applied: the state of the node now."
    },
    "maintenance": {
      "type": "boolean",
      "description": "Only in stage applied: whether the maintenance flag is on."
    },
    "until_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400,
      "description": "Only in stage applied: seconds left of the pause, identify or maintenance window the order started."
    },
    "since_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Only in stage applied: the wall-clock time (ms) when the pause or standby began; 0 if the clock of the node is not set."
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firmware",
        "uptime_s",
        "reset_reason",
        "heap_free",
        "heap_min",
        "mqtt_connected",
        "state",
        "maintenance"
      ],
      "description": "Only in stage diagnostics: a read-only snapshot, no secret in it.",
      "properties": {
        "firmware": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
        },
        "uptime_s": {
          "type": "integer",
          "minimum": 0
        },
        "reset_reason": {
          "type": "string",
          "enum": [
            "power_on",
            "external",
            "software",
            "panic",
            "int_wdt",
            "task_wdt",
            "other_wdt",
            "deep_sleep",
            "brownout",
            "sdio",
            "usb",
            "jtag",
            "efuse",
            "power_glitch",
            "cpu_lockup",
            "unknown"
          ],
          "description": "Why the node started this time: power_on, external (the reset pin), software (a restart it asked for, an update included), panic, int_wdt, task_wdt, other_wdt, deep_sleep, brownout, sdio, usb, jtag, efuse, power_glitch, cpu_lockup or unknown."
        },
        "heap_free": {
          "type": "integer",
          "minimum": 0
        },
        "heap_min": {
          "type": "integer",
          "minimum": 0
        },
        "psram_free": {
          "type": "integer",
          "minimum": 0
        },
        "stack_min_free": {
          "type": "integer",
          "minimum": 0
        },
        "rssi": {
          "type": "integer",
          "minimum": -120,
          "maximum": 0
        },
        "mqtt_connected": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "paused",
            "standby"
          ]
        },
        "maintenance": {
          "type": "boolean"
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detail",
            "log",
            "truncated"
          ],
          "description": "Only with `detail` on the order: the diagnostic package (`detail` package) or the newest log alone (`detail` log). It is built on the node from an allow-list and washed of every secret it knows; the server keeps the latest one of each node and shows it to administrators (and to a read-only diagnostic token the administrator issued).",
          "properties": {
            "detail": {
              "type": "string",
              "enum": [
                "package",
                "log"
              ]
            },
            "heap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "internal_free",
                "internal_min",
                "internal_largest",
                "total_free",
                "total_min"
              ],
              "properties": {
                "internal_free": {
                  "type": "integer",
                  "minimum": 0
                },
                "internal_min": {
                  "type": "integer",
                  "minimum": 0
                },
                "internal_largest": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_free": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_min": {
                  "type": "integer",
                  "minimum": 0
                },
                "psram_free": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "tasks": {
              "type": "array",
              "maxItems": 40,
              "description": "The tasks of the node with the least stack each has had, the shortest first.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "stack_free",
                  "priority",
                  "state"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 15
                  },
                  "stack_free": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "priority": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "R",
                      "r",
                      "B",
                      "S",
                      "D",
                      "?"
                    ]
                  }
                }
              }
            },
            "resets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "uptime_s",
                "guard_restarts_in_hour"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "enum": [
                    "power_on",
                    "external",
                    "software",
                    "panic",
                    "int_wdt",
                    "task_wdt",
                    "other_wdt",
                    "deep_sleep",
                    "brownout",
                    "sdio",
                    "usb",
                    "jtag",
                    "efuse",
                    "power_glitch",
                    "cpu_lockup",
                    "unknown"
                  ]
                },
                "uptime_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "guard_restarts_in_hour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            },
            "boot": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cause",
                "reset_reason",
                "coredump",
                "deliberate",
                "guard"
              ],
              "description": "Only after a dirty start (a crash, a watchdog, a sag of the supply, an out-of-memory, a restart of the guard) and only for the first ten minutes of the run: why the last run ended. A clean start says nothing. The server keeps it once, in the node's log of restarts and in the History.",
              "properties": {
                "cause": {
                  "type": "string",
                  "enum": [
                    "panic",
                    "task_watchdog",
                    "interrupt_watchdog",
                    "other_watchdog",
                    "brownout",
                    "power_glitch",
                    "cpu_lockup",
                    "out_of_memory",
                    "guard_missing_task",
                    "guard_low_memory",
                    "guard_dead_man",
                    "guard"
                  ],
                  "description": "Why the last run ended: a crash (panic), a watchdog, a sag of the supply (brownout, power_glitch), the CPU locking up, an allocation that failed (out_of_memory) or a restart of the node's own guard (guard_missing_task, guard_low_memory, guard_dead_man, guard)."
                },
                "reset_reason": {
                  "type": "string",
                  "enum": [
                    "power_on",
                    "external",
                    "software",
                    "panic",
                    "int_wdt",
                    "task_wdt",
                    "other_wdt",
                    "deep_sleep",
                    "brownout",
                    "sdio",
                    "usb",
                    "jtag",
                    "efuse",
                    "power_glitch",
                    "cpu_lockup",
                    "unknown"
                  ],
                  "description": "The reset reason of the chip at this start."
                },
                "uptime_before_s": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "How long the node had run when it ended, as of the last look the guard took (a few seconds before the end at most). Absent when the node could not keep it."
                },
                "heap_internal_free": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The internal memory free at that last look; sent with heap_internal_largest."
                },
                "heap_internal_largest": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The biggest block of internal memory at that last look (never more than heap_internal_free)."
                },
                "coredump": {
                  "type": "boolean",
                  "description": "A core dump of the crash is waiting in the node's flash (an administrator of the node's panel can read it)."
                },
                "deliberate": {
                  "type": "boolean",
                  "description": "Someone asked for the last restart on purpose (the server's order, the panel)."
                },
                "guard": {
                  "type": "boolean",
                  "description": "The node's own guard asked for the last restart."
                }
              }
            },
            "memory_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "closed",
                "transitions",
                "close_free",
                "close_block",
                "open_free",
                "open_block"
              ],
              "description": "The memory gate at the door of the panel: closed or open, how often it changed, and the levels it works by.",
              "properties": {
                "closed": {
                  "type": "boolean",
                  "description": "The gate at the door of the node's panel is closed: new connections are refused while the internal memory is short."
                },
                "transitions": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "How many times the gate has opened or closed since the node started."
                },
                "close_free": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Bytes of free internal memory under which the gate closes."
                },
                "close_block": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Bytes of the biggest internal block under which the gate closes."
                },
                "open_free": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Bytes of free internal memory over which the gate opens again."
                },
                "open_block": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Bytes of the biggest internal block over which the gate opens again."
                }
              }
            },
            "versions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "firmware",
                "idf",
                "sensors"
              ],
              "properties": {
                "firmware": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
                },
                "idf": {
                  "type": "string",
                  "maxLength": 32
                },
                "board": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "sensors": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "version"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 32
                      },
                      "version": {
                        "type": "string",
                        "maxLength": 32
                      }
                    }
                  }
                }
              }
            },
            "config": {
              "type": "object",
              "maxProperties": 64,
              "description": "The settings the node may show: only the leaves of a fixed list of names (modes, intervals, channels, language, switches) as short text (a number or a switch is written as text: \"30\", \"true\"), and the address of the broker as scheme, host and port. Never a name of the house, a user, a password, a key, a token or a certificate.",
              "additionalProperties": {
                "type": "string",
                "maxLength": 96
              }
            },
            "coredump": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present"
              ],
              "properties": {
                "present": {
                  "type": "boolean"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1
                },
                "summary": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "task"
                  ],
                  "properties": {
                    "task": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 96
                    },
                    "pc": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{1,16}$"
                    },
                    "backtrace": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{1,16}$"
                      }
                    },
                    "app_sha256": {
                      "type": "string",
                      "maxLength": 16
                    }
                  }
                }
              }
            },
            "log": {
              "type": "string",
              "maxLength": 6000,
              "description": "The newest part of the node's log, printable text only, washed of anything that looks like a credential."
            },
            "truncated": {
              "type": "boolean",
              "description": "The log or the settings did not fit and were cut."
            }
          }
        }
      }
    }
  }
}
